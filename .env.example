# Server Configuration
PORT=8080
ENV=development

# Firebase Configuration
FIREBASE_PROJECT_ID=your-project-id
# Path to the service account key. Never commit this file.
# Leave empty to use Application Default Credentials (Cloud Run, gcloud auth).
GOOGLE_APPLICATION_CREDENTIALS=./service_account.json

# Security
# Comma separated browser origins allowed by CORS (mobile apps are not affected)
CORS_ALLOW_ORIGINS=*
# Per-IP request limit per minute
RATE_LIMIT_PER_MINUTE=60

# docker-compose host port
HOST_PORT=1000
